# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment files — never commit these, they may hold secrets.
# Covers bare `.env` plus every variant (.env.local, .env.production,
# .env.development, .env.*.local). Document required vars in .env.example,
# which is the one deliberate exception.
.env
.env.*
!.env.example
!.env.*.example

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local ev-ui dev copy (published to npm, not part of this repo)
ev-ui/

# Screenshot reference images
public/*.JPG
public/*.jpg
public/*.PNG
public/*.png

# Brand assets — keep tracked despite the public/*.png rule above
!public/compass-logo-dark.png
!public/compass-favicon-*.png

# Editor/tooling backups. A `.env.bak` holding live credentials sat
# untracked in ev-accounts on 2026-07-26 and a single `git add -A`
# would have published it.
*.bak
*.backup
*.orig
*~

# Playwright MCP page captures. 556 of these were committed to
# ev-accounts and held live credentials.
.playwright-mcp/
