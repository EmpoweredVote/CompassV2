# Template for local env files. Safe to commit — no real values here.
# Copy to `.env.local` (git-ignored) and fill in what you need.
#
# Every VITE_* var is exposed to the browser in the built bundle, so none of
# them may ever hold a true secret. Server-side secrets belong in the
# deploy platform's dashboard, never in this repo.

# --- Optional: all have code-level fallbacks ---------------------------------

# Vite `base` — public path assets are served from.
# vite.config.js: base: env.VITE_BASE || "/"
VITE_BASE=/

# React Router basename.
# src/main.jsx: <BrowserRouter basename={import.meta.env.VITE_BASENAME || "/"}>
VITE_BASENAME=/

# Cross-app link target for the Compare panel.
# src/components/ComparePanel.jsx: || "https://essentials.empowered.vote"
VITE_ESSENTIALS_URL=https://essentials.empowered.vote

# --- Deployed environments should set this ------------------------------------

# PostHog project key. Analytics is a silent no-op when unset, which is the
# right behaviour for local dev. Public (client-side) key, not a secret, but
# leave it unset here so real project keys never land in git.
# VITE_POSTHOG_KEY=

# Note: the API origin is NOT configurable via env. src/lib/auth.js hardcodes
# it — a relative `/api` in dev (proxied by vite.config.js to dodge CORS) and
# an absolute prod URL in builds. render.yaml sets VITE_API_URL, but nothing
# in src/ reads it.
